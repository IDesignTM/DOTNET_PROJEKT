@model IEnumerable<Sklep.Core.Models.ProductVariant>

@{
    ViewData["Title"] = "Warianty produktu";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-uppercase fw-bold text-dark mb-0" style="letter-spacing: 0.05em;">Warianty: @ViewBag.ProductName</h2>
        <div class="d-flex gap-2">
            <a asp-action="Create" asp-route-productId="@ViewBag.ProductId" class="btn btn-dark text-uppercase px-4" style="font-size: 0.85rem; letter-spacing: 0.05em;">Dodaj wariant</a>
            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary text-uppercase px-4" style="font-size: 0.85rem; letter-spacing: 0.05em;">Powrót</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm bg-white">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase small fw-bold" style="letter-spacing: 0.05em;">
                    <tr>
                        <th class="ps-4 py-3">Rozmiar</th>
                        <th class="py-3">Kolor</th>
                        <th class="py-3">Stan magazynowy</th>
                        <th class="text-end pe-4 py-3">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted small">Brak wariantów dla tego produktu.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@item.Size?.Name</td>
                                <td>@(string.IsNullOrEmpty(item.Color) ? "Brak (Uniwersalny)" : item.Color)</td>
                                <td>
                                    @if (item.StockQuantity > 0)
                                    {
                                        <span class="badge bg-success text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">@item.StockQuantity szt.</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Brak na stanie</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Na pewno usunąć ten wariant?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Usuń</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>