@model Sklep.Core.Models.DTOs.ProductVariantDto

@{
    ViewData["Title"] = "Dodaj wariant";
}

<div class="container py-4">
    <h2 class="mb-4">Dodaj wariant do produktu</h2>

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                <input type="hidden" asp-for="ProductId" value="@ViewBag.ProductId" />

                <div class="mb-3">
                    <label asp-for="SizeId" class="form-label fw-bold">Rozmiar</label>
                    <select asp-for="SizeId" class="form-select" asp-items="@ViewBag.Sizes">
                        <option value="">-- Wybierz rozmiar --</option>
                    </select>
                    <span asp-validation-for="SizeId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Color" class="form-label fw-bold">Kolor</label>
                    <input asp-for="Color" class="form-control" placeholder="np. Czarny, Biały, Czerwony" />
                    <span asp-validation-for="Color" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="StockQuantity" class="form-label fw-bold">Stan magazynowy (ilość sztuk)</label>
                    <input asp-for="StockQuantity" type="number" class="form-control" />
                    <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Zapisz wariant</button>
                    <a asp-action="Index" asp-route-productId="@ViewBag.ProductId" class="btn btn-outline-secondary">Anuluj</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}