@model Sklep.Core.Models.DTOs.ProductVariantDto

@{
    ViewData["Title"] = "Dodaj wariant";
}

<div class="container py-4">
    <h2 class="mb-4 text-uppercase fw-bold" style="letter-spacing: 0.05em;">Dodaj wariant</h2>

    <div class="card border-0 shadow-sm bg-white p-4" style="max-width: 500px;">
        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="ProductId" value="@ViewBag.ProductId" />

            <div class="mb-4">
                <label asp-for="SizeId" class="form-label fw-bold small text-uppercase">Rozmiar</label>
                <select asp-for="SizeId" class="form-select" asp-items="@ViewBag.Sizes">
                    <option value="">-- Wybierz rozmiar --</option>
                </select>
                <span asp-validation-for="SizeId" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Color" class="form-label fw-bold small text-uppercase">Kolor</label>
                <input asp-for="Color" class="form-control" placeholder="np. Czarny, Biały, Czerwony" />
                <span asp-validation-for="Color" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="StockQuantity" class="form-label fw-bold small text-uppercase">Stan magazynowy (ilość sztuk)</label>
                <input asp-for="StockQuantity" type="number" class="form-control" />
                <span asp-validation-for="StockQuantity" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark text-uppercase px-4" style="letter-spacing: 0.05em;">Zapisz wariant</button>
                <a asp-action="Index" asp-route-productId="@ViewBag.ProductId" class="btn btn-outline-secondary text-uppercase px-4" style="letter-spacing: 0.05em;">Anuluj</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}