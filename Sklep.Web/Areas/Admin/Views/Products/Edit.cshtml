@model Sklep.Core.DTOs.ProductEditDto

@{
    ViewData["Title"] = "Edytuj produkt";
}

<h2>Edytuj produkt</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Nazwa</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Opis</label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label">Cena</label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">Kategoria</label>
        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
            <option value="">-- Wybierz kategorię --</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Obecne zdjęcia (Zaznacz, aby usunąć)</label>
        @if (Model.ExistingImages != null && Model.ExistingImages.Any())
        {
            <div class="d-flex flex-wrap gap-3 mt-2">
                @foreach (var img in Model.ExistingImages)
                {
                    <div class="card" style="width: 150px;">
                        <img src="@img.ImagePath" class="card-img-top" style="height: 150px; object-fit: cover;" alt="Zdjęcie produktu">
                        <div class="card-body text-center p-2 bg-light border-top">
                            <div class="form-check d-inline-block">
                                <input class="form-check-input" type="checkbox" name="ImagesToDelete" value="@img.Id" id="del_@img.Id">
                                <label class="form-check-label text-danger small" for="del_@img.Id">Usuń</label>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted small">Brak przypisanych zdjęć.</p>
        }
    </div>

    <div class="mb-4">
        <label class="form-label fw-bold">Dodaj nowe zdjęcia</label>
        <input type="file" name="Images" class="form-control" multiple accept="image/jpeg,image/png,image/jpg" />
        <small class="text-muted">Dozwolone formaty: JPG, PNG.</small>
    </div>

    <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
    <a asp-action="Index" class="btn btn-secondary">Wróć</a>
</form>