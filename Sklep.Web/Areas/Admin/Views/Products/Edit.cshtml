@model Sklep.Core.DTOs.ProductEditDto

@{
    ViewData["Title"] = "Edytuj produkt";
}

<div class="container py-4">
    <h2 class="mb-4 text-uppercase fw-bold" style="letter-spacing: 0.05em;">Edytuj produkt</h2>

    <div class="card border-0 shadow-sm bg-white p-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold small text-uppercase">Nazwa produktu</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold small text-uppercase">Opis</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label fw-bold small text-uppercase">Cena (PLN)</label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label fw-bold small text-uppercase">Kategoria</label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                    <option value="">-- Wybierz kategorię --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold small text-uppercase" style="letter-spacing: 0.05em;">Tagi produktu</label>
                <div class="d-flex flex-wrap gap-3 p-3 border rounded bg-light">
                    @if (ViewBag.Tags != null)
                    {
                        foreach (var tag in (IEnumerable<Sklep.Core.Models.Tag>)ViewBag.Tags)
                        {
                            bool isChecked = Model != null && Model.SelectedTags != null && Model.SelectedTags.Contains(tag.Id);
                            
                            <div class="form-check">
                                <input class="form-check-input" 
                                       type="checkbox" 
                                       name="SelectedTags" 
                                       value="@tag.Id" 
                                       id="tag_@tag.Id" 
                                       @(isChecked ? "checked" : "")>
                                <label class="form-check-label px-1" for="tag_@tag.Id">
                                    @tag.Name
                                </label>
                            </div>
                        }
                    }
                    else
                    {
                        <span class="text-muted small">Brak zdefiniowanych tagów w bazie.</span>
                    }
                </div>
            </div>
            
            <div class="mb-4">
                <label class="form-label fw-bold small text-uppercase">Obecne zdjęcia (Zaznacz, aby usunąć)</label>
                @if (Model.ExistingImages != null && Model.ExistingImages.Any())
                {
                    <div class="d-flex flex-wrap gap-3 mt-2">
                        @foreach (var img in Model.ExistingImages)
                        {
                            <div class="card shadow-sm" style="width: 150px; border-radius: 4px; overflow: hidden;">
                                <img src="@img.ImagePath" class="card-img-top" style="height: 150px; object-fit: cover;" alt="Zdjęcie produktu">
                                <div class="card-body text-center p-2 bg-light border-top">
                                    <div class="form-check d-inline-block">
                                        <input class="form-check-input" type="checkbox" name="ImagesToDelete" value="@img.Id" id="del_@img.Id">
                                        <label class="form-check-label text-danger small fw-bold" for="del_@img.Id">USUŃ</label>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="p-2 border rounded bg-light text-muted small">Brak przypisanych zdjęć na serwerze.</div>
                }
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold small text-uppercase">Dodaj nowe zdjęcia</label>
                <input type="file" name="Images" class="form-control" multiple accept="image/jpeg,image/png,image/jpg" />
                <small class="text-muted">Dozwolone formaty: JPG, PNG. Zostaną dopisane jako kolejne załączniki.</small>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-dark text-uppercase px-4" style="letter-spacing: 0.05em;">Zapisz zmiany</button>
                <a asp-action="Index" class="btn btn-outline-secondary text-uppercase px-4" style="letter-spacing: 0.05em;">Anuluj</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}