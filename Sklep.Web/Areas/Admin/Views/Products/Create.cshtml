@model Sklep.Core.Models.Product

@{
    ViewData["Title"] = "Dodaj produkt";
}

<h2>Dodaj produkt</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Nazwa</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Opis</label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label">Cena</label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">Kategoria</label>
        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
            <option value="0">-- Wybierz kategorię --</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label class="form-label fw-bold">Tagi produktu</label>
        <div class="d-flex flex-wrap gap-3">
            @if (ViewBag.Tags != null)
            {
                foreach (var tag in (IEnumerable<Sklep.Core.Models.Tag>)ViewBag.Tags)
                {
                    bool isChecked = Model != null && Model.Tags != null && Model.Tags.Any(t => t.Id == tag.Id);
                    
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="selectedTags" value="@tag.Id" id="tag_@tag.Id" @(isChecked ? "checked" : "")>
                        <label class="form-check-label" for="tag_@tag.Id">
                            @tag.Name
                        </label>
                    </div>
                }
            }
        </div>
    </div>
    
    <div class="mb-3">
        <label class="form-label">Zdjęcia</label>
        <input type="file" name="images" class="form-control" multiple accept="image/jpeg,image/png,image/jpg" />
        <small class="text-muted">Dozwolone formaty: JPG, PNG.</small>
    </div>

    <button type="submit" class="btn btn-primary">Zapisz</button>
    <a asp-action="Index" class="btn btn-secondary">Wróć</a>
</form>