@model Sklep.Core.Models.Product

@{
    ViewData["Title"] = "Szczegóły produktu";
}

<div class="container py-4">
    <h2 class="mb-4 text-uppercase fw-bold" style="letter-spacing: 0.05em;">Szczegóły produktu</h2>

    <div class="card mb-4 shadow-sm border-0">
        <div class="card-body p-4">
            <h3 class="fw-bold border-bottom pb-2 mb-3 text-uppercase" style="font-size: 1.25rem; letter-spacing: 0.05em;">@Model.Name</h3>
            <p class="mb-2"><strong>Opis:</strong> @Model.Description</p>
            <p class="mb-2"><strong>Cena:</strong> <span class="fw-bold text-success">@Model.Price.ToString("C")</span></p>
            <p class="mb-2"><strong>Kategoria:</strong> @(Model.Category?.Name ?? "Brak")</p>
            
            <p class="mb-0">
                <strong>Tagi:</strong>
                @if (Model.Tags != null && Model.Tags.Any())
                {
                    foreach (var tag in Model.Tags)
                    {
                        <span class="badge bg-dark text-white me-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">@tag.Name</span>
                    }
                }
                else
                {
                    <span class="text-muted small">Brak przypisanych tagów</span>
                }
            </p>
        </div>
    </div>

    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-light border-0 py-3">
            <h5 class="mb-0 fw-bold text-uppercase" style="font-size: 0.9rem; letter-spacing: 0.05em;">Załączone zdjęcia</h5>
        </div>
        <div class="card-body p-4">
            @if (Model.Images != null && Model.Images.Any())
            {
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var img in Model.Images)
                    {
                        <img src="@img.ImagePath" class="img-thumbnail shadow-sm" style="width: 200px; height: 200px; object-fit: cover; border-radius: 4px;" alt="Zdjęcie produktu" />
                    }
                </div>
            }
            else
            {
                <span class="text-muted small">Brak zdjęć dla tego produktu na serwerze.</span>
            }
        </div>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-dark text-uppercase px-4" style="font-size: 0.85rem; letter-spacing: 0.05em;">Edytuj</a>
        <a asp-action="Index" class="btn btn-outline-secondary text-uppercase px-4" style="font-size: 0.85rem; letter-spacing: 0.05em;">Wróć</a>
    </div>
</div>