@model Sklep.Core.Models.Product

@{
    ViewData["Title"] = "Usuń produkt";
}

<h2>Usuń produkt</h2>

<div class="alert alert-warning">
    Czy na pewno chcesz usunąć: <strong>@Model.Name</strong>?
</div>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Kategoria:</strong> @Model.Category?.Name</p>
        <p><strong>Cena:</strong> @Model.Price</p>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Usuń</button>
    <a asp-action="Index" class="btn btn-secondary">Wróć</a>
</form>