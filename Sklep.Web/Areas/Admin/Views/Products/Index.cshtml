@model IEnumerable<Sklep.Core.Models.Product>

@{
    ViewData["Title"] = "Produkty";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-uppercase fw-bold text-dark mb-0" style="letter-spacing: 0.05em;">Produkty</h2>
        <a asp-action="Create" class="btn btn-dark text-uppercase px-4" style="font-size: 0.85rem; letter-spacing: 0.05em;">Dodaj produkt</a>
    </div>

    <div class="card border-0 shadow-sm bg-white">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase small fw-bold" style="letter-spacing: 0.05em;">
                    <tr>
                        <th class="ps-4 py-3">Nazwa</th>
                        <th class="py-3">Cena</th>
                        <th class="py-3">Kategoria</th>
                        <th class="text-end pe-4 py-3">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-medium text-dark">@item.Name</td>
                            <td class="text-secondary fw-bold">@item.Price.ToString("C")</td>
                            <td>
                                <span class="badge bg-light text-dark border text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                    @(item.Category?.Name ?? "Brak")
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Szczegóły</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Edytuj</a>
                                    <a asp-controller="ProductVariants" asp-action="Index" asp-route-productId="@item.Id" class="btn btn-sm btn-outline-secondary text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Warianty</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Usuń</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>