@model IEnumerable<Sklep.Core.Models.Product>

@{
    ViewData["Title"] = "Produkty";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Produkty</h2>
    <a asp-action="Create" class="btn btn-primary">Dodaj produkt</a>
</div>

<table class="table table-striped align-middle">
    <thead>
    <tr>
        <th>Nazwa</th>
        <th>Cena</th>
        <th>Kategoria</th>
        <th class="text-end">Akcje</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Price</td>
            <td>@item.Category?.Name</td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Szczegóły</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edytuj</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Usuń</a>
                <a asp-controller="ProductVariants" asp-action="Index" asp-route-productId="@item.Id" class="btn btn-sm btn-info text-white">Warianty</a>
            </td>
        </tr>
    }
    </tbody>
</table>