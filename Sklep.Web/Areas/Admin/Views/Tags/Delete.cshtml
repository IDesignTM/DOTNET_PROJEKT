@model Sklep.Core.DTOs.TagDto

@{
    ViewData["Title"] = "Usuń tag";
}

<div class="container py-4">
    <h2 class="mb-4 text-uppercase fw-bold text-danger" style="letter-spacing: 0.05em;">Usuń tag</h2>

    <div class="card border-0 shadow-sm bg-white p-4" style="max-width: 500px;">
        <p class="mb-4">
            Czy na pewno chcesz trwale usunąć tag 
            <span class="badge bg-dark text-white text-uppercase px-2 py-1" style="font-size: 0.8rem; letter-spacing: 0.05em;">@Model.Name</span>? 
            Przypisane do niego produkty utracą to powiązanie.
        </p>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger text-uppercase px-4" style="letter-spacing: 0.05em;">Potwierdź usunięcie</button>
                <a asp-action="Index" class="btn btn-outline-secondary text-uppercase px-4" style="letter-spacing: 0.05em;">Anuluj</a>
            </div>
        </form>
    </div>
</div>