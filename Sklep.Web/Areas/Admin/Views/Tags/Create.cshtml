@model Sklep.Core.DTOs.TagDto

@{
    ViewData["Title"] = "Dodaj tag";
}

<div class="container py-4">
    <h2 class="mb-4 text-uppercase fw-bold" style="letter-spacing: 0.05em;">Dodaj nowy tag</h2>

    <div class="card border-0 shadow-sm bg-white p-4" style="max-width: 500px;">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="Name" class="form-label fw-bold small text-uppercase">Nazwa etykiety (tagu)</label>
                <input asp-for="Name" class="form-control" placeholder="np. Wyprzedaż, Bestseller, Trend" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark text-uppercase px-4" style="letter-spacing: 0.05em;">Zapisz</button>
                <a asp-action="Index" class="btn btn-outline-secondary text-uppercase px-4" style="letter-spacing: 0.05em;">Anuluj</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}