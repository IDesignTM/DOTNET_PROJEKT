@model Sklep.Core.Models.DiscountCode

<h2>Dodaj kod rabatowy</h2>

<form method="post">
    <div class="form-group">
        <label>Kod</label>
        <input asp-for="Code" class="form-control" />
    </div>

    <div class="form-group">
        <label>Rabat (%)</label>
        <input asp-for="DiscountPercent" class="form-control" />
    </div>

    <div class="form-group">
        <label>Ważny do</label>
        <input asp-for="ExpirationDate" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label>Aktywny</label>
        <input asp-for="IsActive" type="checkbox" />
    </div>

    <button class="btn btn-success mt-2">
        Zapisz
    </button>
</form>