@model Sklep.Core.Models.DiscountCode

@{
    ViewData["Title"] = "Dodaj kod rabatowy";
}

<div class="container py-4">
    <h2 class="mb-4 text-uppercase fw-bold" style="letter-spacing: 0.05em;">Dodaj kod rabatowy</h2>

    <div class="card border-0 shadow-sm bg-white p-4" style="max-width: 500px;">
        <form asp-action="Create" method="post">
            <div class="mb-4">
                <label asp-for="Code" class="form-label fw-bold small text-uppercase">Kod</label>
                <input asp-for="Code" class="form-control" />
            </div>

            <div class="mb-4">
                <label asp-for="DiscountPercent" class="form-label fw-bold small text-uppercase">Rabat (%)</label>
                <input asp-for="DiscountPercent" class="form-control" />
            </div>

            <div class="mb-4">
                <label asp-for="ExpirationDate" class="form-label fw-bold small text-uppercase">Data ważności</label>
                <input asp-for="ExpirationDate" type="date" class="form-control" />
            </div>

            <div class="mb-4 form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label fw-bold small text-uppercase">Aktywny</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark text-uppercase px-4" style="letter-spacing: 0.05em;">Zapisz</button>
                <a asp-action="Index" class="btn btn-outline-secondary text-uppercase px-4" style="letter-spacing: 0.05em;">Anuluj</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}