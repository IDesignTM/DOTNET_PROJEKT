@model IEnumerable<Sklep.Core.Models.DiscountCode>

@{
    ViewData["Title"] = "Kody rabatowe";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Kody rabatowe</h2>
    <a asp-action="Create" class="btn btn-primary">Dodaj kod</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Kod</th>
            <th>Rabat</th>
            <th>Aktywny</th>
            <th>Ważny do</th>
            <th class="text-end">Akcje</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Code</td>

                <td>
                    @item.DiscountPercent %
                </td>

                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">Tak</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Nie</span>
                    }
                </td>

                <td>
                    @item.ExpirationDate.ToString("yyyy-MM-dd")
                </td>

                <td class="text-end">
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-warning">
                        Edytuj
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-danger">
                        Usuń
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>