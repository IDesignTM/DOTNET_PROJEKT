@page
@model RegisterModel
@{
    ViewData["Title"] = "Załóż konto";
}

<div class="container py-5">
    <div class="d-flex justify-content-center">
        <div style="width: 100%; max-width: 500px;">

            <h2 class="mb-4 text-uppercase fw-bold text-center" style="letter-spacing: 0.05em;">@ViewData["Title"]</h2>

            <div class="card border-0 shadow-sm bg-white p-4">
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label fw-bold small text-uppercase">E-mail</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nazwa@przyklad.com" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label fw-bold small text-uppercase">Hasło</label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label fw-bold small text-uppercase">Potwierdź hasło</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="btn btn-dark w-100 text-uppercase" style="letter-spacing: 0.05em;">Załóż konto</button>

                    <div class="text-center mt-3 small">
                        <span class="text-muted">Masz już konto? </span>
                        <a asp-page="./Login" class="text-dark fw-bold text-decoration-none">Zaloguj się</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}