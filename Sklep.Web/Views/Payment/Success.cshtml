@model int

@{
    ViewData["Title"] = "Płatność zakończona";
}

<div class="container py-5">
    <div class="d-flex justify-content-center">
        <div class="card border-0 shadow-sm p-5 text-center" style="max-width: 500px; width: 100%;">

            <div class="mb-4">
                <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
            </div>

            <h2 class="text-uppercase fw-bold text-dark mb-3" style="letter-spacing: 0.05em;">Płatność zaksięgowana</h2>

            <p class="text-muted mb-4">Dziękujemy za zakupy. Twoja płatność została pomyślnie przetworzona.</p>

            <div class="bg-light p-3 rounded mb-4">
                <span class="text-muted small text-uppercase fw-bold" style="letter-spacing: 0.05em;">Numer zamówienia</span>
                <div class="fs-4 fw-bold text-dark">#@Model</div>
            </div>

            <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model"
               class="btn btn-dark text-uppercase w-100 py-2" style="letter-spacing: 0.05em;">
                Zobacz zamówienie
            </a>
        </div>
    </div>
</div>