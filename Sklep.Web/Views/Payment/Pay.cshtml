@model Sklep.Core.Models.Payment

@{
    ViewData["Title"] = "Płatność";
}

<h2>Płatność za zamówienie</h2>

<hr />

<p>
    <strong>Kwota do zapłaty:</strong>
    @Model.Amount.ToString("0.00") zł
</p>

<p>
    <strong>Metoda płatności:</strong>
    @Model.Method
</p>

<p>
    <strong>Status:</strong>
    @Model.Status
</p>

<form asp-action="Confirm" method="post">
    <input type="hidden"
           name="paymentId"
           value="@Model.Id" />

    <button type="submit"
            class="btn btn-success">
        Zapłać
    </button>
</form>