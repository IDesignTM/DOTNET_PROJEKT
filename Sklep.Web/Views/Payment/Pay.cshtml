@model Sklep.Core.Models.Payment

@{
    ViewData["Title"] = "Płatność";
}

<div class="container py-5">
    <div class="d-flex justify-content-center">
        <div class="card border-0 shadow-sm bg-white p-4" style="max-width: 500px; width: 100%;">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-uppercase fw-bold text-dark mb-0" style="letter-spacing: 0.05em;">Płatność</h2>
                <a asp-controller="Orders" asp-action="MyOrders" class="btn btn-sm btn-outline-secondary text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Powrót</a>
            </div>

            <div class="mb-3">
                <span class="text-muted small text-uppercase fw-bold" style="letter-spacing: 0.05em;">Kwota do zapłaty:</span>
                <div class="fs-4 fw-bold text-dark">@Model.Amount.ToString("C")</div>
            </div>

            <div class="mb-3">
                <span class="text-muted small text-uppercase fw-bold" style="letter-spacing: 0.05em;">Metoda płatności:</span>
                <div class="fw-medium text-dark">@Model.Method</div>
            </div>

            <div class="mb-4">
                <span class="text-muted small text-uppercase fw-bold" style="letter-spacing: 0.05em;">Status:</span>
                <div class="badge bg-light text-dark border text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">@Model.Status</div>
            </div>

            <hr class="my-3" />

            <form asp-action="Confirm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="paymentId" value="@Model.Id" />

                <button type="submit" class="btn btn-dark text-uppercase w-100 py-2" style="letter-spacing: 0.05em;">
                    Potwierdź płatność
                </button>
            </form>
        </div>
    </div>
</div>