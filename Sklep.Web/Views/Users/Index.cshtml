@model List<Sklep.Core.Models.ApplicationUser>

@{
    ViewData["Title"] = "Użytkownicy";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-uppercase fw-bold text-dark mb-0" style="letter-spacing: 0.05em;">Użytkownicy</h2>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm border-0">@TempData["Error"]</div>
    }

    <div class="card border-0 shadow-sm bg-white">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase small fw-bold" style="letter-spacing: 0.05em;">
                    <tr>
                        <th class="ps-4 py-3">Email</th>
                        <th class="py-3">Login</th>
                        <th class="text-end pe-4 py-3">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-medium text-dark">@user.Email</td>
                            <td class="text-secondary fw-bold">@user.UserName</td>
                            <td class="text-end pe-4">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a asp-action="Manage" asp-route-id="@user.Id" class="btn btn-sm btn-outline-dark text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Zarządzaj</a>
                                    <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Szczegóły</a>

                                    @if (user.Id != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                                    {
                                        <form asp-action="Delete" asp-route-id="@user.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;" onclick="return confirm('Czy na pewno usunąć użytkownika?')">
                                                Usuń
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>