@model Sklep.Core.Models.ApplicationUser

@{
    ViewData["Title"] = "Zarządzanie użytkownikiem";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-uppercase fw-bold text-dark mb-0" style="letter-spacing: 0.05em;">Zarządzanie użytkownikiem</h2>
        <a asp-action="Index" class="btn btn-outline-secondary text-uppercase px-4" style="font-size: 0.85rem; letter-spacing: 0.05em;">Powrót</a>
    </div>

    <div class="card border-0 shadow-sm bg-white p-4" style="max-width: 500px;">
        <div class="mb-4">
            <div class="mb-2">
                <span class="text-muted small text-uppercase fw-bold" style="letter-spacing: 0.05em;">Login:</span>
                <span class="ms-2 fw-medium text-dark">@Model.UserName</span>
            </div>
            <div class="mb-2">
                <span class="text-muted small text-uppercase fw-bold" style="letter-spacing: 0.05em;">Email:</span>
                <span class="ms-2 fw-medium text-dark">@Model.Email</span>
            </div>
            <div class="mb-2">
                <span class="text-muted small text-uppercase fw-bold" style="letter-spacing: 0.05em;">Status admina:</span>
                <span class="ms-2 fw-bold text-uppercase @(ViewBag.IsAdmin ? "text-success" : "text-danger")" style="font-size: 0.85rem;">
                    @(ViewBag.IsAdmin ? "Tak" : "Nie")
                </span>
            </div>
        </div>

        <hr class="my-3" />

        <div class="mt-2">
            @if (!(bool)ViewBag.IsAdmin)
            {
                <form asp-action="MakeAdmin" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-dark text-uppercase w-100" style="letter-spacing: 0.05em;">
                        Nadaj uprawnienia administratora
                    </button>
                </form>
            }
            else
            {
                <form asp-action="RemoveAdmin" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-danger text-uppercase w-100" style="letter-spacing: 0.05em;">
                        Odbierz uprawnienia administratora
                    </button>
                </form>
            }
        </div>
    </div>
</div>