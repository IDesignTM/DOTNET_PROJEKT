@model Sklep.Core.Models.ApplicationUser

<h2>Zarządzanie użytkownikiem</h2>

<p>
    <strong>Email:</strong>
    @Model.Email
</p>

<p>
    <strong>Login:</strong>
    @Model.UserName
</p>

<p>
    <strong>Admin:</strong>
    @(ViewBag.IsAdmin ? "Tak" : "Nie")
</p>

@if (!(bool)ViewBag.IsAdmin)
{
    <form asp-action="MakeAdmin" method="post">
        <input type="hidden" name="id" value="@Model.Id" />

        <button type="submit"
                class="btn btn-success">
            Nadaj Admina
        </button>
    </form>
}
else
{
    <form asp-action="RemoveAdmin" method="post">
        <input type="hidden" name="id" value="@Model.Id" />

        <button type="submit"
                class="btn btn-danger">
            Odbierz Admina
        </button>
    </form>
}