@model Sklep.Core.Models.ApplicationUser

@{
    ViewData["Title"] = "Szczegóły użytkownika";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-uppercase fw-bold text-dark mb-0" style="letter-spacing: 0.05em;">Szczegóły użytkownika</h2>
        <a asp-action="Index" class="btn btn-outline-secondary text-uppercase px-4" style="font-size: 0.85rem; letter-spacing: 0.05em;">Powrót</a>
    </div>

    <div class="card border-0 shadow-sm bg-white p-4" style="max-width: 600px;">
        <h6 class="text-uppercase fw-bold text-muted mb-3" style="letter-spacing: 0.1em;">Informacje podstawowe</h6>

        <div class="mb-2">
            <span class="text-muted small text-uppercase fw-bold" style="letter-spacing: 0.05em;">Login:</span>
            <span class="ms-2 fw-medium text-dark">@Model.UserName</span>
        </div>

        <div class="mb-3">
            <span class="text-muted small text-uppercase fw-bold" style="letter-spacing: 0.05em;">Email:</span>
            <span class="ms-2 fw-medium text-dark">@Model.Email</span>
        </div>

        <hr class="my-4" />

        <h6 class="text-uppercase fw-bold text-muted mb-3" style="letter-spacing: 0.1em;">Statystyki zakupów</h6>

        <div class="row text-center">
            <div class="col-6 border-end">
                <div class="text-muted small text-uppercase fw-bold" style="letter-spacing: 0.05em;">Zamówienia</div>
                <div class="fs-3 fw-bold text-dark">@ViewBag.OrdersCount</div>
            </div>
            <div class="col-6">
                <div class="text-muted small text-uppercase fw-bold" style="letter-spacing: 0.05em;">Wydano łącznie</div>
                <div class="fs-3 fw-bold text-success">@ViewBag.TotalSpent.ToString("C")</div>
            </div>
        </div>

    </div>
</div>