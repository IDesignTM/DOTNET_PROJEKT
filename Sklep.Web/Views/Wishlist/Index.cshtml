@model Sklep.Core.Models.Wishlist

@{
    ViewData["Title"] = "Lista życzeń";
}

<div class="container py-5" style="min-height: 75vh;">
    <h1 class="display-6 fw-bold mb-5 text-uppercase" style="letter-spacing: 0.05em;">Lista życzeń</h1>

    @if (Model == null || Model.Items == null || !Model.Items.Any())
    {
        <div class="text-center py-5 border rounded bg-white shadow-sm">
            <p class="text-muted text-uppercase mb-4" style="letter-spacing: 0.1em;">Twoja lista życzeń jest pusta</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-dark text-uppercase px-4 py-2" style="font-size: 0.85rem; letter-spacing: 0.1em;">Przeglądaj sklep</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-4 g-4">
            @foreach (var item in Model.Items)
            {
                if (item.Product == null) continue;
                
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm" style="border-radius: 4px; overflow: hidden;">
                        <div style="height: 300px; background-color: #fafafa; overflow: hidden;" class="d-flex align-items-center justify-content-center border-bottom">
                            @if (item.Product.Images != null && item.Product.Images.Any())
                            {
                                <img src="@item.Product.Images.First().ImagePath" class="card-img-top" alt="@item.Product.Name" style="width: 100%; height: 100%; object-fit: cover;">
                            }
                            else
                            {
                                <span class="text-muted text-uppercase small" style="letter-spacing: 0.1em;">Brak zdjęcia</span>
                            }
                        </div>
                        <div class="card-body d-flex flex-column align-items-start p-3 bg-white">
                            <h6 class="fw-bold text-uppercase mb-1" style="letter-spacing: 0.05em; font-size: 0.95rem;">@item.Product.Name</h6>
                            <span class="text-muted mb-3" style="font-size: 0.9rem;">@item.Product.Price.ToString("C")</span>
                            
                            <div class="mt-auto d-flex w-100 gap-2">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Product.Id" class="btn btn-outline-dark btn-sm flex-grow-1 text-uppercase small" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                    Zobacz
                                </a>
                                
                                <form asp-action="RemoveFromWishlist" method="post" class="m-0 p-0">
                                    <input type="hidden" name="itemId" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none border" style="font-size: 0.75rem;" title="Usuń z listy">
                                        ✕
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>