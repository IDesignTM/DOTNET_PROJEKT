@model IEnumerable<Sklep.Core.Models.Product>

@{
ViewData["Title"] = "Sklep";
}

<div class="container mt-4">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var item in Model)
        {
        <div class="col">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-img-top d-flex align-items-center justify-content-center bg-light rounded-top" style="height: 200px;">
                    <span class="text-muted small">Brak zdjęcia</span>
                </div>

                <div class="card-body text-center">
                    <h5 class="card-title mb-2">
                        <a asp-action="Details" asp-route-id="@item.Id" class="text-dark text-decoration-none fw-bold">
                            @item.Name
                        </a>
                    </h5>
                    
                <span class="product-price">
                        @item.Price.ToString("C")
                    </span>
                </div>
            </div>
        </div>
        }
    </div>
</div>