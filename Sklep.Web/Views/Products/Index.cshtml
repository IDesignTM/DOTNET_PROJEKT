@model IEnumerable<Sklep.Core.Models.Product>

@{
    ViewData["Title"] = "Sklep";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        
        @if (ViewBag.CurrentCategory != null)
        {
            <h3 class="text-uppercase mb-0" style="letter-spacing: 0.1em;">@ViewBag.CurrentCategory</h3>
        }
        else
        {
            <h3 class="text-uppercase mb-0" style="letter-spacing: 0.1em;">ALL PRODUCTS</h3>
        }

        <div class="dropdown">
            <button class="btn btn-outline-dark dropdown-toggle text-uppercase" style="letter-spacing: 0.05em;" type="button" id="categoryFilter" data-bs-toggle="dropdown" aria-expanded="false">
                FILTER
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="categoryFilter">
                <li>
                    <a class="dropdown-item" asp-action="Index" asp-route-categoryName="">ALL PRODUCTS</a>
                </li>
                <li><hr class="dropdown-divider"></li>
                
                @if (ViewBag.Categories != null)
                {
                    foreach (var cat in (IEnumerable<Sklep.Core.Models.Category>)ViewBag.Categories)
                    {
                        <li>
                            <a class="dropdown-item" asp-action="Index" asp-route-categoryName="@cat.Name">
                                @cat.Name
                            </a>
                        </li>
                    }
                }
            </ul>
        </div>

    </div>
    
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-img-top d-flex align-items-center justify-content-center bg-light rounded-top" style="height: 200px; overflow: hidden;">
                        @if (item.Images != null && item.Images.Any())
                        {
                            <a asp-action="Details" asp-route-id="@item.Id">
                                <img src="@item.Images.First().ImagePath"
                                     alt="@item.Name"
                                     style="width: 100%; height: 100%; object-fit: cover;" />
                            </a>
                        }
                        else
                        {
                            <span class="text-muted small text-uppercase" style="letter-spacing: 0.1em;">NO IMAGE</span>
                        }
                    </div>

                    <div class="card-body text-center">
                        <h5 class="card-title mb-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-dark text-decoration-none fw-bold">
                                @item.Name
                            </a>
                        </h5>

                        <span class="product-price">
                            @item.Price.ToString("C")
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>