@model Sklep.Core.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="container-fluid px-0" style="background-color: #fafafa;">
    <div class="container py-5">
        
        <div class="row mb-3">
            <div class="col text-end small">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted fw-light" style="letter-spacing: 0.1em;">HOME</a>
                <span class="mx-1">/</span> 
                <a asp-area="" asp-controller="Products" asp-action="Index" class="text-decoration-none text-muted fw-light" style="letter-spacing: 0.1em;">SHOP</a> 
                <span class="mx-1">/</span> 
                <span class="text-muted">@Model.Name.ToUpper()</span>
            </div>
        </div>
        
        <div class="row g-0" style="min-height: 80vh; background-color: white; border-radius: 4px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
            
            <div class="col-md-7 border-end" style="background-color: white;">
                <div class="d-flex flex-column h-100 p-5 position-relative">
                    
                    <div class="d-flex align-items-center justify-content-center flex-grow-1 bg-light rounded" style="min-height: 500px; margin-bottom: 20px; border: 1px solid #eee;">
                        <div class="d-flex align-items-center justify-content-center text-center p-4">
                            <div class="me-4 text-muted">
                                <p class="small mt-1 mb-0">Brak<br>zdjecia</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-5 d-flex flex-column" style="background-color: white;">
                <div class="p-5 d-flex flex-column flex-grow-1 align-items-start">
                    
                    <h1 class="display-6 fw-bold mb-3 text-uppercase" style="letter-spacing: 0.05em;">@Model.Name</h1>
                    
                    <span class="product-price">@Model.Price.ToString("C")</span>

                    <hr class="w-100 my-4" style="border-top: 1px solid #eee;">

                    <div class="d-grid gap-3 w-100 mb-5">
                        <button class="btn btn-outline-dark btn-lg shadow-sm" type="button" style="text-transform: uppercase; font-size: 0.9rem; letter-spacing: 0.1em; border-width: 2px;">
                            Add to Cart
                        </button>
                    </div>

                    <hr class="w-100 my-4" style="border-top: 1px solid #eee;">
                    
                    <div class="w-100">
                        <h6 class="fw-bold text-uppercase mb-3" style="letter-spacing: 0.1em;">Product Description</h6>
                        <p class="lead text-muted" style="white-space: pre-line; font-size: 1rem; line-height: 1.6;">
                            @if (string.IsNullOrEmpty(Model.Description))
                            {
                                <span>Brak opisu dla tego produktu.</span>
                            }
                            else
                            {
                                @Model.Description
                            }
                        </p>
                    </div>
                    <div class="flex-grow-1"></div>
                </div>
            </div>
        </div>
    </div>
</div>