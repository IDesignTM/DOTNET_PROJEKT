@model List<Sklep.Core.Models.CartItem>

@{
    ViewData["Title"] = "Koszyk";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-uppercase fw-bold text-dark mb-0" style="letter-spacing: 0.05em;">Koszyk</h2>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm p-4 text-center">
            <p class="text-muted mb-0">Twój koszyk jest pusty.</p>
        </div>
    }
    else
    {
        decimal total = Model.Sum(x => x.Product.Price * x.Quantity);

        <div class="card border-0 shadow-sm bg-white mb-4">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase small fw-bold" style="letter-spacing: 0.05em;">
                        <tr>
                            <th class="ps-4 py-3">Produkt</th>
                            <th class="py-3">Cena jedn.</th>
                            <th class="py-3">Ilość</th>
                            <th class="text-end pe-4 py-3">Wartość</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-medium text-dark">@item.Product.Name</td>
                                <td class="text-secondary">@item.Product.Price.ToString("C")</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <a asp-action="Decrease" asp-route-id="@item.Product.Id" class="btn btn-sm btn-outline-dark" style="width: 30px;">-</a>
                                        <span class="fw-bold" style="min-width: 20px; text-align: center;">@item.Quantity</span>
                                        <a asp-action="Increase" asp-route-id="@item.Product.Id" class="btn btn-sm btn-outline-dark" style="width: 30px;">+</a>
                                    </div>
                                </td>
                                <td class="text-end pe-4 fw-bold text-dark">@((item.Product.Price * item.Quantity).ToString("C"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-light border-0 p-4 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-uppercase" style="letter-spacing: 0.05em;">
                    Suma: <span class="fw-bold">@total.ToString("C")</span>
                </h5>
                <a asp-controller="Orders" asp-action="Checkout" class="btn btn-dark text-uppercase px-4" style="letter-spacing: 0.05em;">
                    Przejdź do zamówienia
                </a>
            </div>
        </div>
    }
</div>