@model List<Sklep.Core.Models.CartItem>

<h2>Koszyk</h2>

@if (!Model.Any())
{
    <p>Koszyk jest pusty.</p>
}
else
{
    decimal total = 0;

    <table class="table">
        <thead>
            <tr>
                <th>Produkt</th>
                <th>Cena za sztukę</th>
                <th>Ilość</th>
                <th>Wartość</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                total += item.Product.Price * item.Quantity;

                <tr>
                    <td>@item.Product.Name</td>

                    <td>@item.Product.Price zł</td>

                    <td>
                        <a class="btn btn-warning btn-sm"
                           asp-action="Decrease"
                           asp-route-id="@item.Product.Id">
                            -
                        </a>

                        <span class="mx-2">
                            @item.Quantity
                        </span>

                        <a class="btn btn-success btn-sm"
                           asp-action="Increase"
                           asp-route-id="@item.Product.Id">
                            +
                        </a>
                    </td>

                    <td>
                        @((item.Product.Price * item.Quantity).ToString("0.00")) zł
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h4>Suma: @total zł</h4>

    <a asp-controller="Orders"
       asp-action="Checkout"
       class="btn btn-success">
        Przejdź do zamówienia
    </a>
}