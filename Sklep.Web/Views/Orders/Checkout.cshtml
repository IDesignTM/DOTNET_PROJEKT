@model Sklep.Web.ViewModels.CheckoutViewModel

<h2>Zamówienie</h2>

<form asp-action="Checkout" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label>Imię</label>
        <input asp-for="FirstName" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Nazwisko</label>
        <input asp-for="LastName" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Zapisane adresy</label>
        <select asp-for="SelectedAddressId" id="savedAddressSelect" class="form-control">
            <option value="">-- wybierz --</option>

            @foreach (var a in ViewBag.Addresses)
            {
                <option value="@a.Id"
                        data-address="@a.Street"
                        data-city="@a.City"
                        data-postal="@a.PostalCode">
                    @a.Street, @a.City, @a.PostalCode
                </option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label>Ulica</label>
        <input asp-for="Address" id="addressInput" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Miasto</label>
        <input asp-for="City" id="cityInput" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Kod pocztowy</label>
        <input asp-for="PostalCode" id="postalInput" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Kod rabatowy</label>
        <div class="d-flex gap-2">
            <input asp-for="DiscountCode" id="discountCode" class="form-control" />
            <button type="button" id="checkDiscount" class="btn btn-outline-primary">
                Sprawdź
            </button>
        </div>

        <small id="discountMessage"></small>
    </div>

    <div class="mb-3">
        <label>Metoda dostawy</label>

        <select asp-for="ShippingMethodId" class="form-control" id="shippingSelect">
            <option value="" data-price="0">-- wybierz --</option>

            @foreach (var s in ViewBag.ShippingMethods)
            {
                <option value="@s.Id" data-price="@s.Price">
                    @s.Name (@s.Price zł)
                </option>
            }
        </select>
    </div>

    <input type="hidden" id="baseTotal" value="@ViewBag.Total" />

    <br>
    <h5>Do zapłaty: <span id="totalPrice">@ViewBag.Total</span> zł</h5>
    <br>

    <button type="submit" class="btn btn-success">
        Złóż zamówienie
    </button>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const select = document.getElementById("savedAddressSelect");

            select.addEventListener("change", function () {

                const selected =
                    this.options[this.selectedIndex];

                document.getElementById("addressInput").value =
                    selected.dataset.address || "";

                document.getElementById("cityInput").value =
                    selected.dataset.city || "";

                document.getElementById("postalInput").value =
                    selected.dataset.postal || "";
            });

        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // ===== ELEMENTY =====
            const shippingSelect = document.getElementById("shippingSelect");
            const totalPriceEl = document.getElementById("totalPrice");
            const baseTotalEl = document.getElementById("baseTotal");
            const discountInput = document.getElementById("discountCode");
            const checkBtn = document.getElementById("checkDiscount");
            const msg = document.getElementById("discountMessage");

            // ===== STAN =====
            const baseTotal = parseFloat(baseTotalEl.value || "0");
            let discountPercent = 0;

            // ===== FUNKCJA LICZENIA =====
            function recalc() {

                const shippingOption = shippingSelect.options[shippingSelect.selectedIndex];
                const shipping = parseFloat(shippingOption?.dataset.price || "0");

                const discounted = baseTotal - (baseTotal * discountPercent / 100);
                const finalTotal = discounted + shipping;

                totalPriceEl.innerText = finalTotal.toFixed(2);
            }

            // ===== DOSTAWA =====
            shippingSelect.addEventListener("change", recalc);

            // ===== RABAT =====
            checkBtn.addEventListener("click", async function () {

                const formData = new FormData();
                formData.append("code", discountInput.value);

                const response = await fetch('/Orders/ValidateDiscount', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken':
                            document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                });

                const data = await response.json();

                console.log("discount response:", data);

                if (data.valid) {
                    discountPercent = Number(data.percent || 0);
                    msg.textContent = "Kod aktywny";
                    msg.className = "text-success";
                } else {
                    discountPercent = 0;
                    msg.textContent = "Kod nieprawidłowy";
                    msg.className = "text-danger";
                }

                recalc();
            });

            // ===== START =====
            recalc();
        });
    </script>
</form>