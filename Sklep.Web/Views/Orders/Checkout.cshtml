@model Sklep.Web.ViewModels.CheckoutViewModel

<h2>Zamówienie</h2>

<form asp-action="Checkout" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label>Imię</label>
        <input asp-for="FirstName" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Nazwisko</label>
        <input asp-for="LastName" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Zapisane adresy</label>
        <select asp-for="SelectedAddressId" id="savedAddressSelect" class="form-control">
            <option value="">-- wybierz --</option>

            @foreach (var a in ViewBag.Addresses)
            {
                <option value="@a.Id"
                        data-address="@a.Street"
                        data-city="@a.City"
                        data-postal="@a.PostalCode">
                    @a.Street, @a.City, @a.PostalCode
                </option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label>Ulica</label>
        <input asp-for="Address" id="addressInput" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Miasto</label>
        <input asp-for="City" id="cityInput" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Kod pocztowy</label>
        <input asp-for="PostalCode" id="postalInput" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Kod rabatowy</label>
        <div class="d-flex gap-2">
            <input asp-for="DiscountCode" id="discountCode" class="form-control" />
            <button type="button" id="checkDiscount" class="btn btn-outline-primary">
                Sprawdź
            </button>
        </div>

        <small id="discountMessage"></small>
    </div>

    <br>
    <h5>Do zapłaty: <span id="totalPrice">@ViewBag.Total</span> zł</h5>
    <br>

    <button type="submit" class="btn btn-success">
        Złóż zamówienie
    </button>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const select = document.getElementById("savedAddressSelect");

            select.addEventListener("change", function () {

                const selected =
                    this.options[this.selectedIndex];

                document.getElementById("addressInput").value =
                    selected.dataset.address || "";

                document.getElementById("cityInput").value =
                    selected.dataset.city || "";

                document.getElementById("postalInput").value =
                    selected.dataset.postal || "";
            });

        });
    </script>

    <script>
        let baseTotal = parseFloat('@ViewBag.Total');

        document.getElementById("checkDiscount")
            .addEventListener("click", async function () {

            const code = document.getElementById("discountCode").value;
            const msg = document.getElementById("discountMessage");

            const formData = new FormData();
            formData.append("code", code);

            const response = await fetch('/Orders/ValidateDiscount', {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken':
                        document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            });

            const data = await response.json();

            msg.textContent = data.message;
            msg.className = data.valid ? "text-success" : "text-danger";

            let finalTotal = baseTotal;

            if (data.valid) {
                const discount = data.percent;
                finalTotal = baseTotal - (baseTotal * discount / 100);
            }

            document.getElementById("totalPrice").textContent =
                finalTotal.toFixed(2);
        });
    </script>
</form>