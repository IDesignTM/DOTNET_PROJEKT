@model List<Sklep.Core.Models.Order>

<h2>Wszystkie zamówienia</h2>

<table class="table">
    <thead>
        <tr>
            <th>Nr</th>
            <th>Klient</th>
            <th>Miasto</th>
            <th>Kwota</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>#@order.Id</td>
                <td>@order.FirstName @order.LastName</td>
                <td>@order.City</td>
                <td>@order.TotalPrice.ToString("C")</td>
                <td>@order.Status</td>
                <td>
                    <a asp-action="Manage"
                       asp-route-id="@order.Id"
                       class="btn btn-primary btn-sm">
                        Zarządzaj
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>