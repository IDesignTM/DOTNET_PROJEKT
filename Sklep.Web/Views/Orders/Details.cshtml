@model Sklep.Core.Models.Order

<h2>Zamówienie #@Model.Id</h2>

<hr />

@if (Model.Status == "Nowe")
{
    <span class="badge bg-primary">@Model.Status</span>
}
else if (Model.Status == "W realizacji")
{
    <span class="badge bg-warning">@Model.Status</span>
}
else if (Model.Status == "Wysłane")
{
    <span class="badge bg-info">@Model.Status</span>
}
else if (Model.Status == "Dostarczone")
{
    <span class="badge bg-success">@Model.Status</span>
}
else
{
    <span class="badge bg-danger">@Model.Status</span>
}

<p>
    <strong>Imię:</strong>
    @Model.FirstName
</p>

<p>
    <strong>Nazwisko:</strong>
    @Model.LastName
</p>

<p>
    <strong>Ulica:</strong>
    @Model.Address
</p>

<p>
    <strong>Miasto:</strong>
    @Model.City
</p>

<p>
    <strong>Kod pocztowy:</strong>
    @Model.PostalCode
</p>

<hr />

<h4>Produkty</h4>

<table class="table">
    <thead>
        <tr>
            <th>Produkt</th>
            <th>Ilość</th>
            <th>Cena za sztukę</th>
            <th>Wartość</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Product.Name</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("C")</td>
                <td>@((item.Quantity * item.UnitPrice).ToString("C"))</td>
            </tr>
        }
    </tbody>

    @if (!string.IsNullOrEmpty(Model.ShippingMethodName))
    {
        <tr class="table-light">
            <td>@Model.ShippingMethodName</td>
            <td>1</td>
            <td>@Model.ShippingPrice zł</td>
            <td>@Model.ShippingPrice zł</td>
        </tr>
    }

    @if (Model.DiscountAmount > 0)
    {
        <tr>
            <td>Rabat</td>
            <td>-@Model.DiscountAmount zł (@Model.DiscountCode)</td>
        </tr>
    }
</table>

<h4>Płatność</h4>

<p>
    <strong>Status:</strong>
    @Model.Payment?.Status
</p>

<p>
    <strong>Metoda:</strong>
    @Model.Payment?.Method
</p>

@if (Model.Payment != null &&
    Model.Payment.Status == "Oczekująca")
{
    <a asp-controller="Payment"
       asp-action="Pay"
       asp-route-orderId="@Model.Id"
       class="btn btn-success">
        Opłać zamówienie
    </a>
}

<a asp-action="GeneratePdf"
   asp-route-id="@Model.Id"
   class="btn btn-success">
    Pobierz fakturę PDF
</a>

<h4>
    Razem:
    @Model.TotalPrice.ToString("C")
</h4>