@model IEnumerable<Sklep.Core.Models.Order>

@{
    ViewData["Title"] = "Moje zamówienia";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-uppercase fw-bold text-dark mb-0" style="letter-spacing: 0.05em;">Moje zamówienia</h2>
    </div>

    <div class="card border-0 shadow-sm bg-white">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase small fw-bold" style="letter-spacing: 0.05em;">
                    <tr>
                        <th class="ps-4 py-3">Numer</th>
                        <th class="py-3">Data</th>
                        <th class="py-3">Kwota</th>
                        <th class="py-3">Status</th>
                        <th class="text-end pe-4 py-3">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted small">Nie masz jeszcze żadnych zamówień.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-medium text-dark">#@order.Id</td>
                                <td class="text-secondary">@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="fw-bold text-dark">@order.TotalPrice.ToString("C")</td>
                                <td>
                                    <span class="badge bg-light text-dark border text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                        @order.Status
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-dark text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Szczegóły</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>