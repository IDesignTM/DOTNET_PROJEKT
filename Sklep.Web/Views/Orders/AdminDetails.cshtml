@model Sklep.Core.Models.Order

<h2>Szczegóły zamówienia #@Model.Id</h2>

<hr />

<p><strong>Klient:</strong> @Model.FirstName @Model.LastName</p>
<p><strong>Adres:</strong> @Model.Address</p>
<p><strong>Miasto:</strong> @Model.City</p>
<p><strong>Kod pocztowy:</strong> @Model.PostalCode</p>
<p><strong>Status:</strong> @Model.Status</p>
<p><strong>Wartość:</strong> @Model.TotalPrice zł</p>

<h4>Produkty</h4>

<table class="table">
    <thead>
        <tr>
            <th>Produkt</th>
            <th>Ilość</th>
            <th>Cena za sztukę</th>
            <th>Wartość</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Product.Name</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("C")</td>
                <td>@((item.Quantity * item.UnitPrice).ToString("C"))</td>
            </tr>
        }
    </tbody>

    @if (!string.IsNullOrEmpty(Model.ShippingMethodName))
    {
        <tr class="table-light">
            <td>@Model.ShippingMethodName</td>
            <td>1</td>
            <td>@Model.ShippingPrice zł</td>
            <td>@Model.ShippingPrice zł</td>
        </tr>
    }

    @if (Model.DiscountAmount > 0)
    {
        <tr>
            <td>Rabat</td>
            <td>-@Model.DiscountAmount zł (@Model.DiscountCode)</td>
        </tr>
    }
</table>

<a asp-action="AllOrders" class="btn btn-secondary">
    Powrót
</a>