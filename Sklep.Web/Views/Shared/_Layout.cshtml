@using Sklep.Web.Helpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sklep.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Sklep.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Sklep.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Products" asp-action="Index">Sklep</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark"
                                   href="#"
                                   id="adminDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    Panel administracji
                                </a>

                                <ul class="dropdown-menu shadow-sm"
                                    aria-labelledby="adminDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Products" asp-action="Index">
                                            Zarządzaj produktami
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                                            Zarządzaj kategoriami
                                        </a>
                                    </li>
                                </ul>
                                    
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Orders"
                                   asp-action="AllOrders">
                                    Zamówienia
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Users"
                                   asp-action="Index">
                                    Użytkownicy
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Admin"
                                   asp-action="Index">
                                    Statystyki
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Orders"
                               asp-action="MyOrders">
                                Moje zamówienia
                            </a>
                            <li class="nav-item me-2">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Wishlist" asp-action="Index" style="font-size: 1.2rem; line-height: 1;">
                                    ❤️
                                </a>
                            </li>
                            <li class="nav-item me-3">
                                <a class="nav-link text-dark text-nowrap" asp-controller="Cart" asp-action="Index" style="font-size: 1.2rem; line-height: 1;">
                                    🛒 <span class="fs-6 fw-bold">(@CartSessionHelper.GetCartCount(Context.Session))</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link text-muted">Witaj @User.Identity.Name!</span>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-area="Identity" asp-page="/Account/Logout" class="m-0 p-0">
                                    <button type="submit" class="nav-link btn btn-link text-dark border-0">Wyloguj</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Zaloguj</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Rejestracja</a>
                            </li>
                        }
                    </ul>
                    
                </div> </div> </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Sklep.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
