@model IEnumerable<Sklep.Core.Models.Address>

<h2>Moje adresy</h2>

<a class="btn btn-primary mb-3" asp-action="Create">
    Dodaj adres
</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Ulica</th>
            <th>Miasto</th>
            <th>Kod</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Street</td>
                <td>@a.City</td>
                <td>@a.PostalCode</td>
                <td>
                    <a class="btn btn-danger btn-sm"
                       asp-action="Delete"
                       asp-route-id="@a.Id">
                        Usuń
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>