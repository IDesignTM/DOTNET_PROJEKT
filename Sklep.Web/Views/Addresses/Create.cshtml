@model Sklep.Core.Models.Address

@{
    ViewData["Title"] = "Dodaj adres";
}

<div class="container py-4">
    <h2 class="mb-4 text-uppercase fw-bold" style="letter-spacing: 0.05em;">Dodaj adres</h2>

    <div class="card border-0 shadow-sm bg-white p-4" style="max-width: 500px;">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-4">
                <label asp-for="Street" class="form-label fw-bold small text-uppercase">Ulica</label>
                <input asp-for="Street" class="form-control" />
                <span asp-validation-for="Street" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="City" class="form-label fw-bold small text-uppercase">Miasto</label>
                <input asp-for="City" class="form-control" />
                <span asp-validation-for="City" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="PostalCode" class="form-label fw-bold small text-uppercase">Kod pocztowy</label>
                <input asp-for="PostalCode" class="form-control" />
                <span asp-validation-for="PostalCode" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark text-uppercase px-4" style="letter-spacing: 0.05em;">Zapisz</button>
                <a asp-action="Index" class="btn btn-outline-secondary text-uppercase px-4" style="letter-spacing: 0.05em;">Anuluj</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}